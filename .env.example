# Credenciais da Meta Marketing API.
# Copie para .env.local no desenvolvimento e defina as mesmas variáveis no deploy.
# Nenhuma delas usa o prefixo NEXT_PUBLIC_: o token nunca chega ao navegador.

# Token de System User com a permissão ads_read.
# Business Manager > Configurações do negócio > Usuários do sistema > Gerar novo token.
# Tokens de System User não expiram; tokens de usuário, sim.
META_ACCESS_TOKEN=

# ID da conta de anúncios, com ou sem o prefixo act_ (ex.: act_123456789 ou 123456789).
META_AD_ACCOUNT_ID=

# Opcional. Versão do Marketing API. Padrão: v25.0
# META_API_VERSION=v25.0

# Somente desenvolvimento. Aponta o app para o mock local (pnpm mock) em vez da
# API real, permitindo testar o dashboard sem token. Ignorado em produção.
# META_GRAPH_HOST=http://127.0.0.1:8799
